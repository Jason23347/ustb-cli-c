/* Package info */
#define PACKAGE_NAME    "@PROJECT_NAME@"
#define PACKAGE_VERSION "@PROJECT_VERSION@"
#define VERSION_DISPLAY "@VERSION_DISPLAY@"
#define CONFIGURE_TIME  "@CONFIGURE_TIME@"
#define GIT_COMMIT_HASH "@GIT_COMMIT_HASH@"

/* Define to 1 if debugging is disabled */
#cmakedefine NDEBUG 1

#cmakedefine WITH_COLOR 1
#cmakedefine WITH_ACCOUNT 1
#cmakedefine WITH_BALANCE 1
#cmakedefine WITH_SPEEDTEST 1
#cmakedefine WITH_COMPLETION 1
#cmakedefine USE_INTERACTIVE 1
#cmakedefine USE_THREADS 1

#cmakedefine HAVE_STRCASESTR 1
